# Copiar a .env y completar. Lo usa docker compose.

POSTGRES_USER=humedales
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=humedales

# Secreto para firmar las sesiones. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true solo cuando la app se sirva por HTTPS
COOKIE_SECURE=false

# Admin inicial: se crea al arrancar la API si ese correo aún no existe
ADMIN_EMAIL=admin@angachilla.cl
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Guardaparques Humedal Angachilla
