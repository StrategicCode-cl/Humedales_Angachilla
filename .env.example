# Copiar a .env y completar. Lo usa docker compose.

POSTGRES_USER=humedales
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=humedales

# Secreto para firmar las sesiones. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true solo cuando la app se sirva por HTTPS
COOKIE_SECURE=false

# Admin inicial: se crea al arrancar la API si ese correo aún no existe
ADMIN_EMAIL=admin@angachilla.cl
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Guardaparques Humedal Angachilla

# Dirección pública del front: el correo de recuperación de contraseña enlaza a APP_URL/restablecer-clave
APP_URL=http://localhost:3001

# Correo saliente (recuperación de contraseña). Si SMTP_HOST queda vacío, los correos
# no se envían y el enlace aparece en el log del backend (útil en desarrollo).
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=la cuenta y SMTP_PASS=una "contraseña de aplicación" de Google (no la clave normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Angachilla App <no-responder@angachilla.cl>
